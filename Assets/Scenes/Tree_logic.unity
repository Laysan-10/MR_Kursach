  m_Name: 
  m_EditorClassIdentifier: 
  people:
  - id: 1
    name:
    - "\u041F\u0440\u0438\u0432\u0435\u0442! \u042D\u0442\u043E \u043C\u043E\u0439
      \u043E\u0441\u0442\u0440\u043E\u0432."
  - id: 2
    name:
    - "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0442\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0434\u043E\u043C"
    - "\u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u044B
      \u0440\u0435\u0441\u0443\u0440\u0441\u044B"
    - "\u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u0434\u0435\u0440\u0435\u0432\u043E"
    - "\"\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0441\u0442\u0440\u043E\u0432
      \u0434\u0435\u0440\u0435\u0432\u0430\""
  - id: 1
    name:
    - "\u042D\u0442\u043E \u043E\u0441\u0442\u0440\u043E\u0432 \u043B\u0435\u0441\u0430!"
  - id: 2
    name:
    - "\u0417\u0434\u0435\u0441\u044C \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044F \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0443"
    - "\u0418 \u0441 \u0435\u0435 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C
      \u0432\u0435\u0449\u0438 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435"
    - "\u0414\u043B\u044F \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
      \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043D\u0443\u0436\u043D\u043E"
    - "\u043A\u0443\u043F\u0438\u0442\u044C \u043C\u043E\u0441\u0442 \u0438 \u0440\u0430\u0437\u043C\u0435\u0442\u0438\u0442\u044C
      \u043C\u0435\u0436\u0443 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u043C\u0438"
    - "\u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0437\u0430\u0439\u0434\u0438
      \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D"
  - id: 1
    name:
    - "\u042D\u0442\u043E \u043E\u0441\u0442\u0440\u043E\u0432 \u0441 \u043A\u043E\u0440\u043E\u0432\u0430\u043C\u0438!"
  - id: 1
    name:
    - "\u042D\u0442\u043E \u043E\u0441\u0442\u0440\u043E\u0432 \u0441\u043D\u0435\u0433\u0430!"
